--- api/index.py
+++ api/index.py
@@ -114,7 +114,7 @@ def get_tmdb_data(title):
     query = request.args.get('q', '').lower()
     if not query:
         return jsonify([])
-	    
+	    
     # Simple case-insensitive containment check
     # Limit to 5 results for speed and UI space
-    matches = [t for t in all_titles if query in t.lower()][:5]
+    matches = [t for t in all_titles if re.search(r'\b' + re.escape(query) + r'\b', t.lower())][:5]
